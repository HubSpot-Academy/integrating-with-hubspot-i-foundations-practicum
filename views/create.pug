doctype html
html 
    head 
        title= `${title}`
        meta(name="viewport" content="width=device-width, initial-scale=1")
        link(rel="stylesheet", href="/css/style.css")
    body    
        h1 Update Custom Object Form
        .form-wrapper
            form(method="POST" action="/update-cobj")
                label(for="name") Name:
                input(type="text" name="name" id="name" placeholder="Enter object name" required)
                
                label(for="description") Description:
                input(type="text" name="description" id="description" placeholder="Enter description")
                
                label(for="category") Category:
                input(type="text" name="category" id="category" placeholder="Enter category")
                
                input(type="submit" value="Create Object")
        
        a(href="/") Return to the homepage
