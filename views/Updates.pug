doctype html
html(lang="en")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        title= `${title}`
    body 
        h1 Create Custom Object Form
        form(action="/update-cobj" method="POST")
            //label(for="Objid") id of red:
            //input(type="text" id="create_objid" name="create_objid" required)
            //br
            label(for="name") Name of red:
            input(type="text" id="name" name="name" required)
