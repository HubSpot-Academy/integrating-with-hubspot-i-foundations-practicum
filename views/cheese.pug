doctype html
html 
    head 
        title= `${title}`
        meta(name="viewport" content="width=device-width, initial-scale=1")
        link(rel="stylesheet", href="/css/style.css")
    body    
        h1 Cheese
        table
            thead
                tr
                    th Name
                    th Origin
                    th Taste
            tbody
                each cheese in data
                    tr 
                        td #{cheese.properties.cheese_name}
                        td #{cheese.properties.cheese_origin}
                        td #{cheese.properties.cheese_taste}