doctype html
html
    head 
        title=title
        meta(name="viewport" content="width=device-width, initial-scale=1")
        link(rel="stylesheet", href="/css/style.css")
    body

    if data.method === 'patch' && data.method !== undefined
        h1 Update Pet #{data.firstname} #{data.lastname}
        hr
        p
            a(href="/") Return to the homepage
        hr
        form(action="/update-pet" method="POST")
            label(for="firstname") First Name:
            input(type="text" name="firstname" value=data.firstname required)
            br
            label(for="lastname") Last Name:
            input(type="text" name="lastname" value=data.lastname required)
            br
            label(for="email") Email:
            input(type="email" name="email" value=data.email readonly)
            br
            button(type="submit") Submit
    else
        h1 New Pet
        hr
        p
            a(href="/") Return to the homepage
        hr
        form(action="/new-pet" method="POST")
            label(for="firstname") First Name:
            input(type="text" name="firstname" required)
            br
            label(for="lastname") Last Name:
            input(type="text" name="lastname" required)
            br
            label(for="email") Email:
            input(type="email" name="email" required)
            br
            button(type="submit") Submit
