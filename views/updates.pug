doctype html
html(lang="en")
    head
        title Update Custom Object Form | Integrating With HubSpot I Practicum
        link(rel="stylesheet", href="/css/style.css")
    body
        h1 Add a new Playset
        .form-wrapper
            form(method="POST")
                label(for="playsetName") Name
                input(type="text" name="playsetName" required)
                label(for="setNumber") Set Number
                input(type="text" name="setNumber")
                label(for="brand") Brand
                select(name="brand")
                    each brand, key in brands
                        option(value=key)  #{brand}
                label(for="theme") Theme
                select(name="theme")
                    each theme, key in themes
                        option(value=key)  #{theme}
                input(type="submit" value="Create")
                a(href="/") Cancel