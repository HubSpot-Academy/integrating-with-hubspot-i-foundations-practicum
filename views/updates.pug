doctype html
html(lang="en")
    head
        title Update Custom Object Form | Integrating With HubSpot I Practicum
        link(rel="stylesheet", href="/css/style.css")
    body
        h1 Add a new Playset
        .form-wrapper
            form(method="POST")
                label(for="playsetName") Name
                input(type="text" name="playsetName" required)
                label(for="setNumber") Set Number
                input(type="text" name="setNumber")
                label(for="brand") Brand
                select(name="brand")
                    option(value="lego")  LEGO
                    option(value="cada")  CaDa
                    option(value="cobi")  Cobi
                    option(value="mould_king")  Mould King
                label(for="theme") Theme
                select(name="theme")
                    option(value="technic")  Technic
                    option(value="creator")  Creator
                    option(value="medieval")  Medieval
                    option(value="mouwwiild_king")  WWII