doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    - const isUpdate = id && id.length > 0
    title #{isUpdate ? 'Update' : 'Add'} Song
    script(src="https://cdn.tailwindcss.com")
  body.bg-gray-100.flex.items-center.justify-center.h-screen.font-sans
    div.bg-white.p-8.rounded-lg.shadow-md.w-full.max-w-md
      h1.text-2xl.font-bold.mb-6.text-gray-800.text-center #{isUpdate ? 'Update Song' : 'Add a New Song'}

      form(action="/add-cobj", method="POST").space-y-4
        input(type="hidden", name="recordId", value=id || "")

        if !isUpdate
          div
            label(for="contactId").block.text-sm.font-medium.text-gray-700 Associate with Contact
            if contacts && contacts.length
              select(id="contactId", name="contactId", class="mt-1 block w-full pl-3 pr-10 py-2 text-base border-gray-300 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm rounded-md")
                option(value="") Select a contact...
                each contact in contacts
                  option(value=contact.id, selected=contact.id === contactId) #{contact.properties.firstname} #{contact.properties.lastname}
            else
              p.text-sm.text-gray-500 No contacts available to associate.

        div
          label(for="name").block.text-sm.font-medium.text-gray-700 Song Name
          input(type="text", id="name", name="name", value=name || "", required, class="mt-1 block w-full px-3 py-2 bg-white border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500")

        div
          label(for="genre").block.text-sm.font-medium.text-gray-700 Genre
          input(type="text", id="genre", name="genre", value=genre || "", class="mt-1 block w-full px-3 py-2 bg-white border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500")

        div
          label(for="singer").block.text-sm.font-medium.text-gray-700 Singer
          input(type="text", id="singer", name="singer", value=singer || "", class="mt-1 block w-full px-3 py-2 bg-white border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500")

        button(type="submit", class="w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500")
          | #{isUpdate ? 'Update Song' : 'Add Song'}

      div.mt-6.text-center
        a(href="/", class='.text-indigo-600.hover:text-indigo-500.text-sm') Return to homepage

