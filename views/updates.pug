doctype html 
html(lang="en")
    head
        title= `${title}`
        meta(name="viewport" content="width=device-width, initial-scale=1")
        link(rel="stylesheet", href="/css/style.css")
    body 
        .form-wrapper
            form(method="POST")
                label(for="videoGameName") Video Game Name
                input(type="text" name="videoGameName" required)
                label(for="releaseDate") Release Date
                input(type="date" name="releaseDate" required)
                label(for="price") Price (USD)
                input(type="number" name="price" min="0.01" step="0.01" required)
                input(type="submit" name="Submit")
        a(href="/") Return to the homepage