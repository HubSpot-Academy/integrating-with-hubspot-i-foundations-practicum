doctype html 
html 
    head 
        title=title
        meta(name="viewport" content="width=device-width, initial-scale=1")
    body 
        h1 Create a New Character
        a(href="/") Return to the homepage

        form(method="POST", action="/update-cobj")

            label(for="name") Character Name 
            input(type="text" name="name" id="name" required)

            label(for="class") Class 
            select(name="class" id="class" reqiured)
                option(value="" disabled selected) Select a class...
                option(value="Rogue") Rogue 
                option(value="Mage") Mage 
                option(value="Warrior") Warrior

            label(for="level") Level 
            input(type="number" name="level" id="level" required)

            button(type="submit") Create Character
