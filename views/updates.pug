
doctype html
html 
    head 
        title= `Update Custom Object Form | Integrating With HubSpot I Practicum`
        meta(name="viewport" content="width=device-width, initial-scale=1")
        link(rel="stylesheet", href="/css/style.css")
    body    
        h1 Update Custom Object Form
        .cards 
            each contact in data
                .card 
                    h2.card__name #{contact.properties.name}
                    p.card__rating Rating: #{contact.properties.rating}
                    p.card__position Position: #{contact.properties.position}
        a(href="/") Back to homepage