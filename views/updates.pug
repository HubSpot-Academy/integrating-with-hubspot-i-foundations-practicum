//- views/updates.pug
doctype html
html
  head
    meta(charset="utf-8")
    title= title
    link(rel="stylesheet", href="/css/style.css")
  body
    a(href="/") ← Return to the homepage
    h1= title
    p Completa las siguientes propiedades para crear un nuevo registro del objeto personalizado.

    form(method="POST", action="/update-cobj")
      each prop in props
        .form-row
          label(for=prop) #{prop}
          input(type="text", id=prop, name=prop, required)
      button(type="submit") Crear registro
