doctype html
html 
    head 
        title= `${title}`
        meta(name="viewport" content="width=device-width, initial-scale=1")
        link(rel="stylesheet", href="/css/style.css")
    body    
        h1 Add New Cheese
        form(action="/create" method="POST")
            .form-group
                label(for="cheese_name") Cheese Name
                input#cheese_name(type="text" name="cheese_name" required)
            .form-group
                label(for="cheese_origin") Cheese Origin
                input#cheese_origin(type="text" name="cheese_origin" required)
            .form-group
                label(for="cheese_taste") Cheese Taste
                input#cheese_taste(type="text" name="cheese_taste" required)
            .form-group
                button(type="submit") Create