doctype html
html(lang="en")
    head
        title= `${title}`
        link(rel="stylesheet", href="/css/style.css")
    body
        a(href="/") Return to the homepage
        .form-wrapper
          h2 Add New Character
          form(method="POST")
            label(for="newName") Character Name:
            input(type="text" name="newName" required)

            label(for="newRole") Role:
            input(type="text" name="newRole" required)

            label(for="newGameTitle") Game Title:
            input(type="text" name="newGameTitle" required)

            input(type="submit" value="Add Character")