doctype html
html
    head
        title= `${title}`
        link(rel="stylesheet", href="/css/style.css")
    body
        h2 Add a New Pet
        .form-container
            form(method="POST" action="/update-cobj")
                div
                    label(for="newName") Pet Name
                    input(type="text" name="newName" required)
                div
                    label(for="newAge") Pet Age
                    input(type="number" name="newAge" required)
                div
                    label(for="newType") Pet Type
                    input(type="text" name="newType" required)
                div
                    button(type="submit") Submit
        br
        a(href="/") Back to homepage