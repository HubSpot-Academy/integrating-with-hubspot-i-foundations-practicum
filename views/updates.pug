doctype html
html 
    head 
        title= `${title}`
        meta(name="viewport" content="width=device-width, initial-scale=1")
        link(rel="stylesheet", href="/css/style.css")
        script(src="/js/main.js")
    body    
        h1 Create/Update Mountain Record
        a(href="/") Return to the homepage
        .form-wrapper 
            form(action="/update-cobj", method="POST")
                .form-group
                    label(for="name") Name
                    input(type="text" name="name" id="name" required)/
                .form-group
                    label(for="location") Location
                    input(type="text" name="location" id="location" placeholder="City, State Abbreviation")/
                .form-group
                    label(for="elevation") Elevation
                    input(type="number" name="elevation" id="elevation" suffix=" ft")/
                .form-group
                    label(for="country") Country
                    select(name="country" id="country")
                        option(value="") Select a country
                        option(value="United States") USA
                        option(value="Canada") Canada
                        option(value="Mexico") Mexico
                .form-group
                    label(for="record_id") Record ID
                        br/
                        span(class="help-text") Use this field to update an existing record using the record id from the #[a(href='/') Mountains Table].
                    input(type="number" name="record_id" id="record_id" placeholder="12345678")/
                button(type="submit") Submit