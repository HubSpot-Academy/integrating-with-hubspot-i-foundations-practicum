doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    //- Conditionally set the title based on whether an 'id' is present
    - const isUpdate = id && id.length > 0
    title #{isUpdate ? 'Update' : 'Create'} Record
    script(src="https://cdn.tailwindcss.com")
  body.bg-gray-100.flex.items-center.justify-center.h-screen.font-sans
    div.bg-white.p-8.rounded-lg.shadow-md.w-full.max-w-md
      //- Conditional title
      h1.text-2xl.font-bold.mb-6.text-gray-800.text-center #{isUpdate ? 'Update Record' : 'Create New Record'}

      form(action="/add-cobj", method="POST").space-y-4
        //- The hidden field is populated with the id if it exists
        input(type="hidden", name="recordId", value=id || "")

        div
          label(for="firstname").block.text-sm.font-medium.text-gray-700 First Name
          //- The input value is pre-filled if 'firstname' data is passed
          input(type="text", id="firstname", name="firstname", value=firstname || "", class="mt-1 block w-full px-3 py-2 bg-white border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500")

        div
          label(for="lastname").block.text-sm.font-medium.text-gray-700 Last Name
          //- The input value is pre-filled if 'lastname' data is passed
          input(type="text", id="lastname", name="lastname", value=lastname || "", class="mt-1 block w-full px-3 py-2 bg-white border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500")

        div
          label(for="email").block.text-sm.font-medium.text-gray-700 Email
          //- The input value is pre-filled if 'email' data is passed
          input(type="email", id="email", name="email", value=email || "", class="mt-1 block w-full px-3 py-2 bg-white border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500")

        //- Conditional button text
        button(type="submit", class="w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500")
          | #{isUpdate ? 'Update Record' : 'Submit New Record'}

      div.mt-6.text-center
        a(href="/", class='text-indigo-600.hover:text-indigo-500.text-sm') Return to homepage

