doctype html
html 
    head 
        title= `${title}`
        meta(name="viewport" content="width=device-width, initial-scale=1")
        link(rel="stylesheet", href="/css/style.css")
    body    
        h1 Add New Pet

        .container
            a(href="/") Return to Homepage

            form(action="http://localhost:3000/update-cobj", method="post").form-wrapper
                label Pet Name
                input#name(type="text", name="name",required)

                label Pet Color
                input#pet_color(type="text", name="pet_color",required)

                label Pet Type
                input#pet_type(type="text", name="pet_type",required)

                input(type="submit", value="Submit")