doctype html
html(lang="en")
  head
    meta(charset="utf-8")
    meta(name="viewport", content="width=device-width, initial-scale=1")
    title= title
    link(rel="stylesheet", href="/css/style.css")
    link(rel="preconnect", href="https://fonts.googleapis.com")
    link(rel="preconnect", href="https://fonts.gstatic.com" crossorigin)
    link(href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap", rel="stylesheet")
  body
    header.app-header
      .container
        .titlebar
          h1.app-title Add / Update Contact
          a.btn(href="/") ← Back

    main.container
      .form-card
        form(method="POST", action="/update-cobj", novalidate)
          .form-row
            label.form-label(for="firstname") First name
            input.form-input#firstname(type="text", name="firstname", required, autocomplete="given-name", placeholder="Jane", autofocus)
            .hint Optional if your data model allows it.
          .form-row
            label.form-label(for="lastname") Last name
            input.form-input#lastname(type="text", name="lastname", required, autocomplete="family-name", placeholder="Doe")
          .form-row
            label.form-label(for="email") Email
            input.form-input#email(type="email", name="email", required, autocomplete="email", placeholder="jane.doe@example.com", inputmode="email")
            .hint We'll never share your email.

          .btn-row
            a.btn(href="/") Cancel
            button.btn.btn-primary(type="submit") Save
