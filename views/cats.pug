doctype html
html
    head
        title= `${title}`
        meta(name="viewport" content="width=device-width, initial-scale=1")
        link(rel="stylesheet", href="/css/style.css")
    body
        // Display success message if available
        if message
            .alert.alert-success
                = message
        h1 Update Custom Object Form | Integrating With HubSpot I Practicum. [Cats]
        h3 Click cat name to update cat.
        .link-wrapper
            a.link(href="/cats") 🐱 Add Another Cat 🐱
            a.link(href="/") Return to the homepage
        .cards
            each cat in data
                .card
                    a(href=`/cats/${cat.id}`)
                        h2.card__name= cat.properties.name
                    p.card__size Size: #{cat.properties.cat_size_descriptor.charAt(0).toUpperCase() + cat.properties.cat_size_descriptor.slice(1)}
                    p.card__color Color: #{cat.properties.cat_color}
                    p.card__chill
                        if cat.properties.chill == "true"
                            span.chill-badge Chill
                        else
                            span.no-chill-badge No Chill
