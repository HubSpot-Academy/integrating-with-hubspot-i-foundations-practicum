doctype html
html
    head
        title= `${title}`
        meta(name="viewport" content="width=device-width, initial-scale=1")
        link(rel="stylesheet", href="/css/style.css")
    body
        h1 Cats
        .cards
            each cat in data
                .card
                    h2.card__name #{cat.properties.name}
                    p.card__size #{cat.properties.cat_size_descriptor}
                    p.card__chill
                        if cat.properties.chill
                            | Chill
                        else
                            | No Chill
