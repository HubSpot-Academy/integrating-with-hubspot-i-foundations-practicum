doctype html
html(lang="en")
    head 
        title= `${title}`
        meta(name="viewport" content="width=device-width, initial-scale=1")
        link(rel="stylesheet", href="/css/style.css")
    body
        h1 pets
        .cards 
            each pet in data
                .card 
                    h2.card__name #{pets.properties.name} (#{pets.properties.type})
                    p.card__email #{pets.properties.breed}