// ** This is a sample of a pug template and how it uses the data passed to it from index.js.

doctype html
html(lang="en")
    head
        title= `${title}`
        meta(name="viewport" content="width=device-width, initial-scale=1")
        link(rel="stylesheet", href="/css/style.css")
    body    
        h1= `${title}`
        p= `${helloMessage}`

        if successMessage
            .alert.alert-success
                p= `${successMessage}`

        p
            a(href="/update-cobj") Add / Update Pet
        p
            a(href="/contacts") Contacts Page
        p
            a(href="/pets") Pets Page
