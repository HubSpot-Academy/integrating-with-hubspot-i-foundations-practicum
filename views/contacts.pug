//- ** This is a sample of a pug template and how it uses the data passed to it from index.js.

doctype html
 html 
     head 
         title= `${title}`
         meta(name="viewport" content="width=device-width, initial-scale=1")
         link(rel="stylesheet", href="/css/style.css")
     body    
         h1 Fast Cars
         .cards 
             each fastCars in data
                 .card 
                     h2.card__name #{fastCars.properties.name}  #{fastCars.properties.model_year}
                     p.card__email #{fastCars.properties.color}  #{fastCars.properties.price}