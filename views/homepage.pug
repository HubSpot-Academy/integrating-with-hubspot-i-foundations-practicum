doctype html
html
  head
    title= title
    link(rel="stylesheet", href="/css/style.css")
  body
    .container
        h1= title

        a(href="/update-cobj") Add/Update this table

        if !data || data.length === 0
            p No records to show.
        else
            table
                thead
                    tr
                        th Name
                        th Special Ability
                        th Power Level
                tbody
                    each item in data
                        tr
                            td= item.properties.name || ''
                            td= item.properties.special_ability || ''
                            td= item.properties.power_level || ''