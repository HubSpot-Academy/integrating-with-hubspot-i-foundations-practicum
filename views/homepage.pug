doctype html
html(lang="en")
    head
        title List of Playsets (Custom Object) | Integrating With HubSpot I Practicum
        link(rel="stylesheet" href="/css/style.css")
    body
        h1 Playsets Table
        a(href="/update-cobj") Add a Playset (custom object)
        table
            tr
                th Name
                th Set Number
                th Brand
                th Theme
            each playset in playsets
                tr
                    td #{playset.properties.name}
                    td #{playset.properties.set_number}
                    td #{enumBrand[playset.properties.brand]}
                    td #{enumTheme[playset.properties.theme]}
