doctype html
html
  head
    title= `${title}`
    meta(name="viewport" content="width=device-width, initial-scale=1")
    link(rel="stylesheet", href="/css/style.css")
  body
    h1 MTG Cards with alternate names
    table
      tbody
        tr
          th Real Name
          th Display Name
          th Type
          th CMC
        each card in data
          tr
            td #{card.properties.card_name}
            td #{card.properties.name}
            td #{card.properties.spell_type}
            td #{card.properties.cmc}
    a(href="/update-cobj") Add to this table
