doctype html
html 
  head 
    title= title
    meta(name="viewport" content="width=device-width, initial-scale=1")
    link(rel="stylesheet", href="/css/style.css")
  body    
    h1 Pets 
    - var url = "http://localhost:3000/update-cobj"
        a(href=url) Add to this table

        table.table 
          thead
            tr 
              th Name 
              th Pet Type 
              th Pet Color
          tbody
            each pet in data
              tr 
                td #{pet.properties.name}
                td #{pet.properties.pet_type}
                td #{pet.properties.pet_color}
