doctype html
html 
    head 
        title= `${title}`
        meta(name="viewport" content="width=device-width, initial-scale=1")
        link(rel="stylesheet", href="/css/style.css")
    body
        .content-wrapper
            h1 Mountains
            a(href="/update-cobj").nav-link Create Mountain Record
            table.mountains
                tr.table-header
                    th Name
                    th Location
                    th Country
                    th(data-type="number") Elevation
                    th
                each mountain in data
                    tr(class="mountain")
                        td #{mountain.properties.name}
                        td #{mountain.properties.location}
                        td #{mountain.properties.country}
                        - var elevation = parseInt(mountain.properties.elevation).toLocaleString();
                        td(data-type="number") #{elevation} ft.
                        td
                            a(href=`/update-cobj?id=${mountain.id}`).update-button Update