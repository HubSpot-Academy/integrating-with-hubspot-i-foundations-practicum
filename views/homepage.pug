doctype html
html(lang="en")
    head
        title= `${title}`
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        link(rel="stylesheet", href="/css/style.css")
    body.content 
        h1 #{title}
        h2 Custom Object Table - Harry Potter Characters

        a(href="/update-cobj") Add/Update this table
        table.table
            thead
                tr
                    th Name
                    th House
                    th Wand Core
                    tbody 
                        each character in characters
                            tr
                                td= character.properties.name
                                td= character.properties.house
                                td= character.properties.wand
