doctype html
html
    head
        title= `${title}`
        meta(name="viewport" content="width=device-width, initial-scale=1")
        link(rel="stylesheet", href="/css/style.css")
    body
        header
            h1 Contacts
        main
            table
                thead
                    tr
                        th Name
                        th Age
                        th Email
                tbody
                    each contact in data
                        tr
                            td #{contact.properties.name}
                            td #{contact.properties.age}
                            td #{contact.properties.email}
        footer
            a(href="/") Return to the homepage
            a(href="/update-cobj") Create new record