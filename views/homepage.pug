doctype html
html 
    head 
        title= `${title}`
        meta(name="viewport" content="width=device-width, initial-scale=1")
        link(rel="stylesheet", href="/css/style.css")
    body    
        h1 Books currently in HubSpot
        a(href="/update-cobj") Add to this table
        table
            tr
                th Book Name 
                th Author 
                th Genre
            each book in data
                tr
                    td=book.properties.name
                    td=book.properties.author
                    td=book.properties.genre
