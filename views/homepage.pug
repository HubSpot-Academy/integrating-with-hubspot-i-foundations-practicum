doctype html
html
    head
        title= title
        meta(name="viewport" content="width=device-width, initial-scale=1")
        link(rel="stylesheet", href="/css/style.css")
    body
        a(href="/update-cobj") Add to this table
        h1= title
        table
            thead
                tr
                    th Name
                    th Species
                    th Breed
            tbody
                each record in records
                    tr
                        td= record.properties.name
                        td= record.properties.species
                        td= record.properties.breed
