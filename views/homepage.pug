doctype html
html
  head
    title= title
    meta(name="viewport" content="width=device-width, initial-scale=1")
    link(rel="stylesheet" href="/css/style.css")

  body
    h1 Pet Records

    p
      a(href="/update-cobj") Add to this table

    if data && data.length
      table
        thead
          tr
            th Name
            th Age
            th Type

        tbody
          each pet in data
            tr
              td= pet.properties.name || ''
              td= pet.properties.age || ''
              td= pet.properties.type || ''
    else
      p No Pet records were found.