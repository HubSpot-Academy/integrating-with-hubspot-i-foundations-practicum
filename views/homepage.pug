doctype html
html
  head
    title= title
    meta(name="viewport", content="width=device-width, initial-scale=1")
    link(rel="stylesheet", href="/css/style.css")
  body
    header
      h1 Contact List
      a(href="/update-cobj") Add to this table

    if contacts && contacts.length
      .cards
        each c in contacts
          .card
            h2.card__name #{(c.properties && c.properties.firstname) || ''} #{(c.properties && c.properties.lastname) || ''}
            p.card__email #{(c.properties && c.properties.email) || ''}
    else
      p No contacts found yet. Try adding one!
