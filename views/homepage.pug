doctype html
html 
    head 
        title= `${title}`
        meta(name="viewport" content="width=device-width, initial-scale=1")
        link(rel="stylesheet", href="/css/style.css")
    body    
        h1 Video Games Table
        a(href="/update-cobj") Add/Update this table
        table(border='1')
            thead 
                tr 
                    th Name
                    th Release Date
                    th Price (USD)
                each videoGame in data
                    tr
                        td= videoGame.properties.name
                        td= videoGame.properties.release_date
                        td= videoGame.properties.price