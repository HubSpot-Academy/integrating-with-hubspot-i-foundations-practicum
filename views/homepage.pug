doctype html
html
    head
        title= title
        meta(name="viewport" content="width=device-width, initial-scale=1")
        link(rel="stylesheet", href="/css/style.css")
    body
        h1 Custom Object Table
        a(href="/update-cobj") Add to this table
        if data.length
            table
                thead
                    tr
                        th Name
                        th Type
                        th Id
                tbody
                    each record in data
                        tr
                            td #{record.properties.name || ''}
                            td #{record.properties.type || ''}
                            td #{record.properties.id || ''}
        else
            p No custom object records found.
