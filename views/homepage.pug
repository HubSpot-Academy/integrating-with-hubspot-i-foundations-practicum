doctype html 
html 
    head 
        title=title
        meta(name="viewport" content="width=device-width, initial-scale=1")
    body 
        h1 Custom Object Table
        a(href="/update-cobj") Add to this table
        table 
            thead 
                tr 
                    th Name 
                    th Class 
                    th Level 
            tbody 
                each object in data
                    tr 
                        td= object.properties.name
                        td= object.properties.class 
                        td= object.properties.level