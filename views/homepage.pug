doctype html
html
    head
        title= title
        link(rel="stylesheet", href="./css/style.css")
    body
        h1 Custom Object Records
        .link
            a(href="/update-cobj") Add / Update this table
        
        .container 
            table(border="1")
                tr
                    th ID
                    th Name
                    th Publisher
                    th Price
                each record in records
                    tr
                        td= record.id
                        td= record.properties.name
                        td= record.properties.publisher
                        td= record.properties.price
