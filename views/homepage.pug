//- ** This is a sample of a pug template and how it uses the data passed to it from index.js.

doctype html
html 
    head 
        title= `${title}`
        meta(name="viewport" content="width=device-width, initial-scale=1")
        link(rel="stylesheet", href="/css/style.css")
    body    
        h1= `${title}`
        p #[a(href=`/`) Add to this table]
            table(style='width:30%', cellspacing='0', cellpadding='0', border='2')
                tr
                    th Name
                    th Is EU
                    th Is GCC
                each country in data
                    tr
                        td(text-align='center')= country.properties.name 
                        td= country.properties.is_eu
                        td= country.properties.is_gcc

