doctype html
html
    head
        title= title
        meta(name="viewport" content="width=device-width, initial-scale=1")
        link(rel="stylesheet", href="/css/style.css")
    body
        h1 Time Tracking
        a.add-link(href="/update-cobj") Add to this table
        table
            thead
                tr
                    th Time Logged
                    th Hours Spent
                    th Billable Rate
                    th Billable Amount
            tbody
                each record in data
                    tr
                        td= record.properties.time_logged ? new Date(Number(record.properties.time_logged)).toLocaleString() : '-'
                        td= record.properties.hours_spent || '-'
                        td= record.properties.billable_rate || '-'
                        td= record.properties.billable_amount || '-'
