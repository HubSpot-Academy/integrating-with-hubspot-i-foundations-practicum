doctype html
html 
    head 
        title= `${title}`
        meta(name="viewport" content="width=device-width, initial-scale=1")
        link(rel="stylesheet", href="/css/style.css")
    body    
        .container
            h1 Custom Object Records

            table
                thead
                    tr
                        <th>Year</th>
                        <th>Name</th>
                        <th>Manufacturer</th>
                tbody
                    each car in data
                        tr
                            td= car.properties.year
                            td= car.properties.name
                            td= car.properties.manufacturer
                    else
                        tr
                            td(colspan="3") No records found.

            p
                a(href="/update-cobj") Add/Update a record