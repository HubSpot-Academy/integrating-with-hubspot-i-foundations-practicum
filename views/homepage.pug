doctype html
html 
    head 
        title= `${title}` 
        meta(name="viewport" content="width=device-width, initial-scale=1")
        link(rel="stylesheet", href="/css/style.css")
    body    
        h1= title
        table 
            thead 
                tr 
                    th Name 
                    th Price
                    th ProductID* 
                        tbody 
                        each item in data
                            tr 
                            td= item.properties.name 
                            td= item.properties.price 
                            td= item.properties.productid 
        a(href="/update-cobj" class="buttonHref") Create/Update Record