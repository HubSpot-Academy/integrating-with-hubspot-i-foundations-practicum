doctype html
html 
    head 
        title= `${title}`
        meta(name="viewport" content="width=device-width, initial-scale=1")
        link(rel="stylesheet", href="/css/style.css")
    body    
        h1 Custom Object Table
        a(href="/update-cobj") Add to this table
        .table-container
            table.table
                thead.table-header
                    tr
                    th Character
                    th Role
                    th Game Title
                tbody
                    each object in data
                        tr
                        td= object.properties.name
                        td= object.properties.role
                        td= object.properties.game_title