doctype html
html
  head
    title= title
    meta(name="viewport" content="width=device-width, initial-scale=1")
    link(rel="stylesheet", href="/css/style.css")
  body
    h1 Custom Object Table
    a.table-link(href="/update-cobj") Add/Update this table
    table
      thead
        tr
          th Name
          th Type
          th Age
      tbody
        each obj in data
          tr
            td= obj.properties.name
            td= obj.properties.type
            td= obj.properties.age
