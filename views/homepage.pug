doctype html
html
  head
    title= title
    meta(name="viewport" content="width=device-width, initial-scale=1")
    link(rel="stylesheet", href="/css/style.css")

  body
    h1 Custom Objects

    a(href="/update-cobj") Add to this table

    if data && data.length
      table
        thead
          tr
            th Name
            th Rating
            th Position
            th HubSpot ID

        tbody
          each record in data
            tr
              td #{record.properties.name}
              td #{record.properties.rating}
              td #{record.properties.position}
              td #{record.id}
    else
      p No custom object records found.